{
  "name": "harvesthub-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "audit:routes": "tsx scripts/auditRoutes.ts",
    "audit:sidebar-routes": "tsx scripts/auditSidebarRoutes.ts",
    "audit:dead-links": "npm run audit:routes && npm run audit:sidebar-routes",
    "clean": "next clean",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "postinstall": "prisma generate && npm run db:deploy:if-server",
    "db:deploy:if-server": "node scripts/prisma-deploy-if-server.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/nextjs-registry": "^1.0.2",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.4.2",
    "@prisma/extension-accelerate": "^3.0.1",
    "@react-email/components": "^1.0.8",
    "@serwist/next": "^9.5.6",
    "@upstash/redis": "^1.36.3",
    "antd": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.9.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.0.0",
    "geist": "^1.5.1",
    "jose": "^6.1.3",
    "lucide-react": "^0.563.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.9.3",
    "serwist": "^9.5.6",
    "tailwind-merge": "^3.4.0",
    "tsx": "^4.21.0",
    "web-push": "^3.6.7",
    "zod": "^3.22.4",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/lodash": "^4.17.23",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.1.2",
    "dotenv": "^17.3.1",
    "eslint": "^8",
    "eslint-config-next": "15.1.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^27.4.0",
    "lodash": "^4.17.23",
    "postcss": "^8",
    "prettier": "^3.1.1",
    "prisma": "^7.5.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
