// MyHarvestHub Database Schema
// Matches lib/types.ts and lib/constants/index.ts

generator client {
  provider   = "prisma-client-js"
  output     = "../prisma/generated/client"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  ADMIN
  VENDOR
  BUYER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum VendorCategory {
  ELECTRONICS
  COMPUTERS_OFFICE
  HOME_APPLIANCES
  FURNITURE
  HOME_DECOR
  KITCHEN_DINING
  FASHION
  BEAUTY
  BABY_KIDS
  TOYS_GAMES
  AUTOMOTIVE
  MOTORCYCLES
  SPARE_PARTS
  INDUSTRIAL
  AGRICULTURE
  SECURITY
  GROCERY_FOOD
  SERVICES
  OTHERS
}

enum ProductCategory {
  // Electronics
  MOBILE_DEVICES
  MOBILE_ACCESSORIES
  AUDIO_WEARABLES
  TV_VIDEO
  CAMERAS
  STORAGE_DEVICES
  NETWORKING
  COMPUTER_ACCESSORIES
  // Computers & Office
  COMPUTERS
  DISPLAYS
  PRINTING_SCANNING
  OFFICE_EQUIPMENT
  // Home Appliances
  LARGE_APPLIANCES
  KITCHEN_APPLIANCES
  CLEANING_APPLIANCES
  COOLING
  // Furniture
  LIVING_ROOM
  BEDROOM
  DINING
  OFFICE_FURNITURE
  STORAGE
  OUTDOOR_FURNITURE
  KIDS_FURNITURE
  // Home Decor
  HOME_DECOR
  // Kitchen & Dining
  COOKWARE
  DINING_SETS
  KITCHEN_TOOLS
  KITCHEN_STORAGE
  BEVERAGE
  // Fashion
  MENS_FASHION
  WOMENS_FASHION
  // Beauty & Personal Care
  BEAUTY_PRODUCTS
  PERSONAL_CARE
  HAIR_WIGS
  // Baby & Kids
  BABY_ESSENTIALS
  // Toys & Games
  TOYS
  // Automotive
  CAR_ESSENTIALS
  CAR_ELECTRONICS
  CAR_MAINTENANCE
  // Motorcycles
  MOTORCYCLE_PARTS
  // Spare Parts
  SPARE_PARTS
  // Industrial & Construction
  INDUSTRIAL_EQUIPMENT
  CONSTRUCTION_TOOLS
  SAFETY_EQUIPMENT
  // Agriculture
  AGRICULTURE
  // Security & Surveillance
  SECURITY_SURVEILLANCE
  // Grocery & Food
  GROCERY
  // Services & Others
  SERVICES
  OTHERS
}

enum Campus {
  LONDON
  BIRMINGHAM
  GLASGOW
  MANCHESTER
  HOUSTON
  NORTH_LONDON
  KENT
  TORONTO
  GBAGADA
  MAGODO
  IKORODU
  IBADAN_JERICHO
  AKOBO
  APAPA
  SURULERE
  ABEOKUTA
  ILUPEJU
  YABA
  PORT_HARCOURT
  OLUYOLE
  OGBA
  ANTHONY
  ALIMOSHO
  IKEJA
  IKOYI
  ISOLO
  IYANA_IPAJA
  ABULE_EGBA
  GHANA
  ABUJA
  LEKKI
  GLOBE
  AJAH
  ONLINE
}

enum Position {
  MEMBER
  NON_MEMBER
  WORKER
  HOD
  ASST_HOD
  SUB_TEAM_LEADER
  TEAM_LEAD
  SMALL_GROUP_LEADER
  ASST_SMALL_GROUP_LEADER
  ZONAL_COORDINATOR
  COMMUNITY_LEADER
  DISTRICT_PASTOR
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  WALLET
  BANK_TRANSFER
  BANK_TRANSFER_PROOF
  CARD
  USSD
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
}

enum PickupService {
  SUNDAY_FIRST
  SUNDAY_SECOND
  MIDWEEK
  SPECIAL_EVENT
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  PAYMENT
  REFUND
  COMMISSION
  PAYOUT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum BannerPosition {
  TOP
  HERO
  SIDEBAR
}

enum BannerTheme {
  BUSINESS
  CHURCH
  EVENT
  PROMOTION
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdApplicationStatus {
  PENDING
  PENDING_PAYMENT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ACTIVE
  EXPIRED
}

enum AdPaymentMethod {
  BANK_TRANSFER
  CARD
  USSD
}

enum AdDurationType {
  HOURLY
  DAILY
}

enum AvailabilityRequestStatus {
  PENDING
  CONFIRMED
  DECLINED
  EXPIRED
}

enum AdStatus {
  PENDING_PAYMENT
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  EXPIRED
  REJECTED
}

enum AdPaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ProofOfTransferStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum VoucherType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_DELIVERY
}

enum MilestoneType {
  FIRST_1000_VENDORS
  FIRST_1000_BUYERS
  FIRST_PURCHASE
  FIRST_SALE
  FIRST_REVIEW
  VENDOR_100_SALES
  CUSTOM
}

enum NotificationType {
  ORDER_CONFIRMED
  ORDER_READY
  ORDER_DELIVERED
  ORDER_CANCELLED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  DELIVERY_UPDATE
  VENDOR_MESSAGE
  LOW_STOCK
  NEW_PRODUCT
  PROMOTION
}

enum ListingType {
  PRODUCT
  SERVICE
}

enum ServiceCategory {
  GROOMING
  BEAUTY_WELLNESS
  CREATIVE
  DIGITAL
  WRITING_TRANSLATION
  TUTORING_COACHING
  HOME_SERVICES
  FOOD_CATERING
  EVENTS
  FASHION_TAILORING
  FITNESS
  CONSULTING
  OTHER_SERVICE
}

enum ServiceRateType {
  FIXED
  HOURLY
  PER_SESSION
  STARTING_FROM
  CUSTOM
}

enum ServiceLocation {
  ON_SITE
  REMOTE
  BOTH
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum VendorContentType {
  IMAGE
  VIDEO
  TEXT
  PROMO_BANNER
}

enum VendorContentStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  EXPIRED
}

// ============================================================================
// MODELS
// ============================================================================

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  password       String
  firstName      String
  lastName       String
  phoneNumber    String
  role           UserRole   @default(BUYER)
  profilePicture String?
  emailVerified  Boolean    @default(false)
  isActive       Boolean    @default(true)
  status         UserStatus @default(ACTIVE)

  // Password reset
  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  // Email verification
  emailVerificationToken  String?   @unique
  emailVerificationExpiry DateTime?

  // Tracks user registration order for milestone features (e.g., first 1000 vendors/buyers)
  registrationSequence Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  buyer                  Buyer?
  vendor                 Vendor?
  addresses              Address[]
  notifications          Notification[]
  wallet                 Wallet?
  bannersCreated         Banner[]
  pushSubscriptions      PushSubscription[]
  notificationPreference NotificationPreference?
  milestones             UserMilestone[]
  advertisements         Advertisement[]
  adApplications         AdApplication[]         @relation("AdApplicationApplicant")
  reviewedAdApplications AdApplication[]         @relation("AdApplicationReviewer")
  proofOfTransfers       ProofOfTransfer[]
  voucherRedemptions     VoucherRedemption[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

model Buyer {
  id          String    @id @default(cuid())
  userId      String    @unique
  dateOfBirth DateTime?
  gender      Gender?

  // Preferences stored as JSON
  preferences Json? @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user                 User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cart                 Cart?
  orders               Order[]
  reviews              Review[]
  availabilityRequests ProductAvailabilityRequest[]
  bookings             Booking[]

  @@index([userId])
  @@map("buyers")
}

model Vendor {
  id                 String         @id @default(cuid())
  userId             String         @unique
  storeName          String
  storeDescription   String?
  category           VendorCategory
  whatsappNumber     String
  campus             Campus
  position           Position?
  status             VendorStatus   @default(PENDING)
  isChurchAffiliated Boolean        @default(false)
  commissionRate     Float          @default(0.05)
  storeLogo          String?
  storeBanner        String?

  // Structured JSON fields
  businessVerification Json?
  storeSettings        Json  @default("{\"allowsPickup\":true,\"allowsDelivery\":false,\"pickupServices\":[],\"deliveryZones\":[]}")

  // Denormalized analytics
  totalSales     Float @default(0)
  totalOrders    Int   @default(0)
  totalProducts  Int   @default(0)
  averageRating  Float @default(0)
  totalReviews   Int   @default(0)
  conversionRate Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user                 User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  products             Product[]
  orders               Order[]
  availabilityRequests ProductAvailabilityRequest[]
  bookings             Booking[]
  vendorContent        VendorContent[]

  @@index([userId])
  @@index([campus])
  @@index([category])
  @@index([status])
  @@map("vendors")
}

model Product {
  id             String          @id @default(cuid())
  vendorId       String
  name           String
  description    String
  category       ProductCategory
  price          Float
  compareAtPrice Float?
  discount       Float           @default(0)
  stock          Int             @default(0)
  images         String[]
  mainImage      String
  variants       Json?
  tags           String[]        @default([])
  isActive       Boolean         @default(true)
  isFeatured     Boolean         @default(false)
  views          Int             @default(0)
  sales          Int             @default(0)
  averageRating  Float           @default(0)
  totalReviews   Int             @default(0)

  // Service vendor support
  listingType    ListingType @default(PRODUCT)
  serviceDetails Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  vendor     Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  reviews    Review[]
  orderItems OrderItem[]
  cartItems  CartItem[]
  bookings   Booking[]

  @@index([vendorId])
  @@index([category])
  @@index([isActive, isFeatured])
  @@index([name])
  @@index([price])
  @@index([listingType])
  @@map("products")
}

model Cart {
  id       String @id @default(cuid())
  buyerId  String @unique
  subtotal Float  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  buyer Buyer      @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([buyerId])
  @@map("carts")
}

model CartItem {
  id               String @id @default(cuid())
  cartId           String
  productId        String
  quantity         Int    @default(1)
  selectedVariants Json?
  price            Float
  subtotal         Float

  addedAt DateTime @default(now())

  // Relations
  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

model Order {
  id              String         @id @default(cuid())
  orderNumber     String         @unique
  buyerId         String
  vendorId        String
  status          OrderStatus    @default(PENDING)
  subtotal        Float
  deliveryFee     Float          @default(0)
  total           Float
  paymentStatus   PaymentStatus  @default(PENDING)
  paymentMethod   PaymentMethod
  deliveryMethod  DeliveryMethod
  deliveryAddress Json?
  pickupDetails   Json?
  notes           String?
  statusHistory   Json           @default("[]")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  // Relations
  buyer            Buyer             @relation(fields: [buyerId], references: [id])
  vendor           Vendor            @relation(fields: [vendorId], references: [id])
  items            OrderItem[]
  transactions     Transaction[]
  proofOfTransfers ProofOfTransfer[]

  @@index([buyerId])
  @@index([vendorId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id               String @id @default(cuid())
  orderId          String
  productId        String
  productName      String
  productImage     String
  quantity         Int
  selectedVariants Json?
  price            Float
  subtotal         Float

  // Relations
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Address {
  id           String  @id @default(cuid())
  userId       String
  label        String
  fullName     String
  phoneNumber  String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  campus       Campus?
  landmark     String?
  isDefault    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Wallet {
  id       String  @id @default(cuid())
  userId   String  @unique
  balance  Float   @default(0)
  currency String  @default("NGN")
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@map("wallets")
}

model Transaction {
  id            String            @id @default(cuid())
  walletId      String
  type          TransactionType
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  status        TransactionStatus @default(PENDING)
  reference     String            @unique
  description   String
  metadata      Json?
  orderId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id])

  @@index([walletId])
  @@index([reference])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("transactions")
}

model Review {
  id                 String       @id @default(cuid())
  productId          String
  buyerId            String
  orderId            String
  rating             Int
  comment            String?
  images             String[]     @default([])
  isVerifiedPurchase Boolean      @default(true)
  helpfulCount       Int          @default(0)
  notHelpfulCount    Int          @default(0)
  isFlagged          Boolean      @default(false)
  status             ReviewStatus @default(PENDING)
  vendorResponse     String?
  vendorRespondedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer   Buyer        @relation(fields: [buyerId], references: [id])
  votes   ReviewVote[]

  @@unique([productId, buyerId, orderId])
  @@index([productId])
  @@index([buyerId])
  @@index([rating])
  @@map("reviews")
}

model Banner {
  id              String         @id @default(cuid())
  title           String
  subtitle        String?
  description     String?
  imageUrl        String
  linkUrl         String?
  actions         Json?
  position        BannerPosition @default(HERO)
  theme           BannerTheme    @default(BUSINESS)
  accentColor     String?
  details         String?
  knowMoreLabel   String?
  isActive        Boolean        @default(true)
  startDate       DateTime       @default(now())
  endDate         DateTime?
  displayOrder    Int            @default(0)
  targetAudience  UserRole[]     @default([])
  clickCount      Int            @default(0)
  impressionCount Int            @default(0)
  createdBy       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  creator User @relation(fields: [createdBy], references: [id])

  @@index([isActive, startDate, endDate])
  @@index([position])
  @@map("banners")
}

model AdApplication {
  id             String              @id @default(cuid())
  userId         String?
  name           String
  email          String
  phoneNumber    String
  companyName    String?
  title          String
  description    String
  imageUrl       String
  linkUrl        String?
  position       BannerPosition      @default(TOP)
  theme          BannerTheme         @default(BUSINESS)
  requestedStart DateTime            @default(now())
  requestedEnd   DateTime?
  status         AdApplicationStatus @default(PENDING)

  paymentMethod      AdPaymentMethod? @default(BANK_TRANSFER)
  amountPaid         Float?
  proofOfTransferUrl String?
  durationType       AdDurationType?  @default(DAILY)
  durationValue      Int?             @default(1)
  activeUntil        DateTime?

  reviewComment String?
  reviewedBy    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  applicant User? @relation("AdApplicationApplicant", fields: [userId], references: [id])
  reviewer  User? @relation("AdApplicationReviewer", fields: [reviewedBy], references: [id])

  @@index([userId])
  @@index([status])
  @@map("ad_applications")
}

model AdRateConfig {
  id         String   @id @default(cuid())
  hourlyRate Float    @default(0)
  dailyRate  Float    @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("ad_rate_config")
}

// ── Commission Configuration (per-category defaults, admin-managed) ──
model CommissionConfig {
  id        String         @id @default(cuid())
  category  VendorCategory @unique
  rate      Float
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("commission_configs")
}

model CommerceLifecycleConfig {
  id                            String   @id @default(cuid())
  key                           String   @unique @default("default")
  autoConfirmEnabled            Boolean  @default(true)
  autoConfirmHours              Int      @default(48)
  refundWindowHours             Int      @default(72)
  withdrawalSettlementHoldHours Int      @default(72)
  paymentsEnabled               Boolean  @default(true)
  commissionDefaultRate         Float    @default(0.05)
  commissionPremiumRate         Float    @default(0.03)
  minOrderAmount                Float    @default(500)
  maxBookingAdvanceDays         Int      @default(60)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@map("commerce_lifecycle_configs")
}

model Notification {
  id       String           @id @default(cuid())
  userId   String
  type     NotificationType
  title    String
  message  String
  link     String?
  isRead   Boolean          @default(false)
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================================
// NEW MODELS
// ============================================================================

model PushSubscription {
  id       String @id @default(cuid())
  userId   String
  endpoint String
  keys     Json

  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model NotificationPreference {
  id                 String  @id @default(cuid())
  userId             String  @unique
  emailNotifications Boolean @default(true)
  smsNotifications   Boolean @default(false)
  pushNotifications  Boolean @default(true)
  orderUpdates       Boolean @default(true)
  promotions         Boolean @default(true)
  vendorMessages     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notification_preferences")
}

model EmailDeliveryLog {
  id          String    @id @default(cuid())
  to          String
  subject     String
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  nextRetryAt DateTime?
  lastError   String?
  providerId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, nextRetryAt])
  @@index([createdAt])
  @@map("email_delivery_logs")
}

model ProductAvailabilityRequest {
  id             String                    @id @default(cuid())
  buyerId        String
  vendorId       String
  items          Json
  status         AvailabilityRequestStatus @default(PENDING)
  buyerNote      String?
  vendorResponse String?
  expiresAt      DateTime

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  // Relations
  buyer  Buyer  @relation(fields: [buyerId], references: [id])
  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@index([buyerId])
  @@index([vendorId])
  @@index([status])
  @@index([expiresAt])
  @@map("product_availability_requests")
}

model Advertisement {
  id              String    @id @default(cuid())
  advertiserId    String
  title           String
  subtitle        String?
  ctaText         String?
  ctaLink         String?
  imageUrl        String
  imagePublicId   String?
  status          AdStatus  @default(PENDING_PAYMENT)
  dailyRate       Float
  startDate       DateTime?
  endDate         DateTime?
  totalPaid       Float     @default(0)
  rejectionReason String?
  impressions     Int       @default(0)
  clicks          Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  advertiser User                @relation(fields: [advertiserId], references: [id])
  payments   AdvertiserPayment[]

  @@index([advertiserId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("advertisements")
}

model AdvertiserPayment {
  id                 String          @id @default(cuid())
  advertisementId    String
  amount             Float
  proofOfTransferUrl String?
  proofPublicId      String?
  bankReference      String?
  status             AdPaymentStatus @default(PENDING)
  verifiedBy         String?
  verifiedAt         DateTime?

  createdAt DateTime @default(now())

  // Relations
  advertisement Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)

  @@index([advertisementId])
  @@index([status])
  @@map("advertiser_payments")
}

model ProofOfTransfer {
  id            String                @id @default(cuid())
  orderId       String?
  userId        String
  imageUrl      String
  imagePublicId String?
  bankReference String?
  amount        Float
  status        ProofOfTransferStatus @default(PENDING)
  verifiedBy    String?
  verifiedAt    DateTime?
  notes         String?

  createdAt DateTime @default(now())

  // Relations
  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@map("proof_of_transfers")
}

model Voucher {
  id                   String      @id @default(cuid())
  code                 String      @unique
  type                 VoucherType
  value                Float
  minOrderAmount       Float?      @default(0)
  maxDiscount          Float?
  usageLimit           Int?
  usedCount            Int         @default(0)
  perUserLimit         Int         @default(1)
  validFrom            DateTime
  validTo              DateTime
  isActive             Boolean     @default(true)
  applicableCategories Json?       @default("[]")
  applicableVendors    Json?       @default("[]")
  createdBy            String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  redemptions VoucherRedemption[]

  @@index([code])
  @@index([isActive, validFrom, validTo])
  @@map("vouchers")
}

model VoucherRedemption {
  id              String  @id @default(cuid())
  voucherId       String
  userId          String
  orderId         String?
  discountApplied Float

  redeemedAt DateTime @default(now())

  // Relations
  voucher Voucher @relation(fields: [voucherId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([voucherId])
  @@index([userId])
  @@index([orderId])
  @@map("voucher_redemptions")
}

model UserMilestone {
  id            String        @id @default(cuid())
  userId        String
  milestoneType MilestoneType
  label         String
  metadata      Json?

  achievedAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([milestoneType])
  @@map("user_milestones")
}

model Booking {
  id         String        @id @default(cuid())
  productId  String
  buyerId    String
  vendorId   String
  date       DateTime
  startTime  String
  endTime    String?
  status     BookingStatus @default(PENDING)
  notes      String?
  totalPrice Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer   Buyer   @relation(fields: [buyerId], references: [id])
  vendor  Vendor  @relation(fields: [vendorId], references: [id])

  @@index([productId])
  @@index([buyerId])
  @@index([vendorId])
  @@index([date])
  @@index([status])
  @@map("bookings")
}

model ReviewVote {
  id       String  @id @default(cuid())
  reviewId String
  userId   String
  helpful  Boolean

  createdAt DateTime @default(now())

  // Relations
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@map("review_votes")
}

model BugReport {
  id          String  @id @default(cuid())
  userId      String?
  title       String
  description String
  category    String
  severity    String  @default("medium")
  status      String  @default("open")
  screenshot  String?
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([severity])
  @@map("bug_reports")
}

enum PublicContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model PublicContent {
  id       String              @id @default(cuid())
  slug     String              @unique
  title    String
  body     String
  metadata Json?               @default("{}")
  status   PublicContentStatus @default(PUBLISHED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@map("public_content")
}

model VendorContent {
  id              String              @id @default(cuid())
  vendorId        String
  type            VendorContentType
  title           String
  description     String?
  mediaUrl        String?
  mediaPublicId   String?
  textContent     String?
  status          VendorContentStatus @default(PENDING)
  rejectionReason String?
  usageRights     Boolean             @default(true)
  targetPlatform  String?
  validFrom       DateTime?
  validTo         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([status])
  @@index([type])
  @@map("vendor_content")
}
