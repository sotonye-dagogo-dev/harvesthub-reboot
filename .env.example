# App Configuration
NEXT_PUBLIC_APP_NAME=HarvestHub
NEXT_PUBLIC_APP_URL=http://localhost:3000

# JWT Secrets (Change these in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production

# Token Expiry
JWT_ACCESS_EXPIRY=8h
JWT_REFRESH_EXPIRY=7d

# API Configuration
API_URL=http://localhost:3000/api

# Currency
NEXT_PUBLIC_CURRENCY_CODE=NGN
NEXT_PUBLIC_CURRENCY_SYMBOL=₦

# Nigerian Market
NEXT_PUBLIC_PHONE_PREFIX=+234
NEXT_PUBLIC_DEFAULT_COUNTRY=Nigeria

# Future: Database (Prisma Accelerate)
# DATABASE_URL=prisma://accelerate.prisma-data.net/?api_key=YOUR_ACCELERATE_API_KEY
# DIRECT_URL=postgresql://username:password@host:5432/harvesthub?sslmode=require

# Future: Redis Cache (Upstash)
# UPSTASH_REDIS_REST_URL=https://YOUR_INSTANCE.upstash.io
# UPSTASH_REDIS_REST_TOKEN=YOUR_TOKEN
# REDIS_PREFIX=harvesthub:

# Future: Cloudinary
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
# CLOUDINARY_ROOT_FOLDER=myharvesthub

# Future: Payment Gateways (Production)
# PAYSTACK_PUBLIC_KEY=pk_test_xxxx
# PAYSTACK_SECRET_KEY=sk_test_xxxx
# FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxx
# FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxx

# Future: Email Service (Production)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=noreply@harvesthub.com

# Environment
NODE_ENV=development
