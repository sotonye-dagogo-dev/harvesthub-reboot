# Database
DATABASE_URL=postgresql://user:password@localhost:5432/myharvesthub

# Prisma (if used)
# Set appropriate shadow database for migrations in CI
PRISMA_SHADOW_DATABASE_URL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Redis (optional caching)
REDIS_URL=redis://localhost:6379

# Next.js
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Feature flags
USE_PRISMA=true
# Use mock data in development (set to false to use real database)
NEXT_PUBLIC_USE_MOCK_DATA=true
# App Configuration
NEXT_PUBLIC_APP_NAME=MyHarvestHub
NEXT_PUBLIC_APP_URL=http://localhost:3000

# JWT Secrets (Change these in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production

# Token Expiry
JWT_ACCESS_EXPIRY=8h
JWT_REFRESH_EXPIRY=7d

# API Configuration
API_URL=http://localhost:3000/api

# Currency
NEXT_PUBLIC_CURRENCY_CODE=NGN
NEXT_PUBLIC_CURRENCY_SYMBOL=₦

# Nigerian Market
NEXT_PUBLIC_PHONE_PREFIX=+234
NEXT_PUBLIC_DEFAULT_COUNTRY=Nigeria

# Database (Prisma Accelerate)
DATABASE_URL=prisma://accelerate.prisma-data.net/?api_key=YOUR_ACCELERATE_API_KEY
DIRECT_URL=postgresql://username:password@host:5432/harvesthub?sslmode=require

# Redis Cache (Upstash — shared DB, all keys namespaced with myharvesthub:)
UPSTASH_REDIS_REST_URL=https://YOUR_INSTANCE.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_TOKEN

# Cloudinary (root folder: myharvesthub/)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Bank Transfer Payment
NEXT_PUBLIC_BANK_NAME=Your Bank Name
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=0000000000
NEXT_PUBLIC_BANK_ACCOUNT_NAME=MyHarvestHub Ltd

# Paystack (mode-switched credentials)
# Set PAYSTACK_MODE=test for development/staging and live for production.
PAYSTACK_MODE=test
PAYSTACK_TEST_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_TEST_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_TEST_CALLBACK_URL=http://localhost:3000/checkout
PAYSTACK_LIVE_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_LIVE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_LIVE_CALLBACK_URL=https://myharvesthub.org/checkout
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_WEBHOOKS_ENABLED=false

# CIS Federation
CIS_API_URL=https://cis.example.com
CIS_PLATFORM_SLUG=myharvesthub
CIS_CLIENT_ID=myharvesthub-client
CIS_CLIENT_SECRET=myharvesthub-client-secret-7f86e0f84c154f34b09a7d12e6f93c41
CIS_WEBHOOK_SECRET=myharvesthub-webhook-secret-1d45a8a62fcb4d7b8b8f2c6d9a7e4b20
CIS_WEBHOOK_PATH=/api/cis/webhook
CIS_WEBHOOK_ALLOWED_SKEW_SECONDS=300

# Email Service (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_EMAIL_FROM=noreply@yourdomain.ng

# Web Push (VAPID keys — generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@myharvesthub.org

# Ad/Banner Rate (NGN per day)
NEXT_PUBLIC_AD_DAILY_RATE=5000

# Site URL (SEO / OG metadata)
NEXT_PUBLIC_SITE_URL=https://myharvesthub.org

# Environment
NODE_ENV=development
