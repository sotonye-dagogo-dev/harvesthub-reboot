# App Configuration
NEXT_PUBLIC_APP_NAME=HarvestHub
NEXT_PUBLIC_APP_URL=http://localhost:3000

# JWT Secrets (Change these in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production

# Token Expiry
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# API Configuration
API_URL=http://localhost:3000/api

# Currency
NEXT_PUBLIC_CURRENCY_CODE=NGN
NEXT_PUBLIC_CURRENCY_SYMBOL=₦

# Nigerian Market
NEXT_PUBLIC_PHONE_PREFIX=+234
NEXT_PUBLIC_DEFAULT_COUNTRY=Nigeria

# Future: Database (Production)
# DATABASE_URL=postgresql://username:password@localhost:5432/harvesthub
# DIRECT_URL=postgresql://username:password@localhost:5432/harvesthub

# Future: Redis Cache (Production)
# REDIS_URL=redis://localhost:6379

# Future: Cloudinary (Production)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
# CLOUDINARY_UPLOAD_PRESET=harvesthub-products

# Future: Payment Gateways (Production)
# PAYSTACK_PUBLIC_KEY=pk_test_xxxx
# PAYSTACK_SECRET_KEY=sk_test_xxxx
# FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxx
# FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxx

# Future: Email Service (Production)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=noreply@harvesthub.com

# Environment
NODE_ENV=development
